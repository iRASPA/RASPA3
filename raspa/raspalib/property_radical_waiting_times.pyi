import collections.abc


class PropertyRadicalWaitingTimes():
    """The times a radical waits between reactions, of the polymerization
    driver."""

    class Histogram():
        """A histogram of waiting times on a logarithmic axis."""

        @property
        def bins_per_decade(self) -> int: ...
        @property
        def counts(self) -> collections.abc.Sequence[int]: ...
        @property
        def count(self) -> int: ...
        @property
        def maximum(self) -> float: ...
        def mean(self) -> float: ...
        def geometric_mean(self) -> float: ...
        def median(self) -> float: ...

        def bin_edges(self) -> collections.abc.Sequence[float]:
            """The edges of the bins [ps], logarithmically spaced."""
            ...

    def __init__(self, bins_per_decade: int = 10, write_every: int = 5000) -> None:
        ...

    @property
    def bins_per_decade(self) -> int: ...
    @property
    def write_every(self) -> int: ...

    def closed(self) -> 'PropertyRadicalWaitingTimes.Histogram':
        """The histogram of the intervals that a reaction ended."""
        ...

    @property
    def by_reaction(self) -> collections.abc.Sequence['PropertyRadicalWaitingTimes.Histogram']:
        """The histograms of the intervals, per reaction that ended them."""
        ...
